{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mediatrove",
  "version": "0.1.25",
  "identifier": "com.mediatracker.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --host 127.0.0.1",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MediaTrove AI",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2MzcwODhGN0Y4QzlGRDcKUldUWG40eC9qd2czRnRuSlNiUjJwY1R6bFIvZUdLWkVxVEtCd3J4b01RY29jVW5PNHlNZXpHR1AK",
      "endpoints": [
        "https://github.com/liumeteor11/mediatrove/releases/latest/download/latest.json"
      ]
    }
  }
}
